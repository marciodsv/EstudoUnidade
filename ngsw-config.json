{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets-locais",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "imagens-externas-cache",
      "urls": [
        "https://www.sescrio.org.br/**",
        "https://cdnsesc.azureedge.net/**"
      ],
      "cacheConfig": {
        "maxSize": 15,
        "maxAge": "7d",
        "timeout": "3s",
        "strategy": "performance"
      }
    },
    {
      "name": "dados-texto-api",
      "urls": [
        "https://api.seusite.com.br/**"
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "1d",
        "timeout": "2s",
        "strategy": "freshness"
      }
    }
  ]
}